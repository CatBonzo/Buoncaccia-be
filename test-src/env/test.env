# Variabili per avviare l'applicazione in locale con utenti e token di prova (profilo mocked)
# contro i container Docker di compose.yaml (prima: docker compose up -d mongo).
# Qui sta il collegamento a MongoDB: SPRING_MONGODB_URI.
# In IntelliJ: configurazione "BuonaCacciaApplication (mocked)" (stessi valori),
#   oppure Run di BuonaCacciaApplication > Environment variables > carica questo file.
# Da riga di comando: set -a; . test-src/env/test.env; set +a; ./gradlew bootRun
# I test automatici (./gradlew build) non le usano: avviano MongoDB con Testcontainers.
SPRING_PROFILES_ACTIVE=mocked
SERVER_PORT=8080
SPRING_MONGODB_URI=mongodb://localhost:27017/buonacaccia-test?directConnection=true
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
