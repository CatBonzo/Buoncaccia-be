# Variabili per provare a mano l'applicazione con utenti e token di prova (profilo mocked)
# su un database separato da quello di sviluppo (buonacaccia-test), con log dettagliati
# (profilo test, application-test.yml). Servono i container di compose.yaml.
# In IntelliJ: Run di BuonaCacciaApplication > Environment variables > carica questo file.
# Da riga di comando: set -a; . questo-file; set +a; ./gradlew bootRun
# I test automatici (./gradlew build) non le usano: avviano MongoDB con Testcontainers.
SPRING_PROFILES_ACTIVE=mocked,test
SERVER_PORT=8080
SPRING_MONGODB_URI=mongodb://localhost:27017/buonacaccia-test?directConnection=true
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
