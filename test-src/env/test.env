# Variabili per i test manuali contro i container di compose.yaml, su un database
# separato da quello di sviluppo. I test automatici (./gradlew test) non le usano.
SPRING_PROFILES_ACTIVE=test
SERVER_PORT=8080
SPRING_MONGODB_URI=mongodb://localhost:27017/buonacaccia-test?directConnection=true
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
