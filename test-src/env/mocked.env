# Variabili per avviare l'applicazione in modalità "mocked" (auth con token mock,
# dati di prova) contro i container di docker-compose.yaml.
# Database di sviluppo buonacaccia (test.env usa invece buonacaccia-test, per tenere separati i dati).
# In IntelliJ: configurazione "BuonaCacciaApplication (mocked)" (stessi valori),
#   oppure Run di BuonaCacciaApplication > Environment variables > carica questo file.
# Da riga di comando: set -a; . questo-file; set +a; ./gradlew bootRun
SPRING_PROFILES_ACTIVE=mocked
SERVER_PORT=8080
SPRING_MONGODB_URI=mongodb://localhost:27017/buonacaccia?directConnection=true
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025

LOGGING_LEVEL=debug
